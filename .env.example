# Copiá este archivo como ".env" y completalo. El .env NO se sube a GitHub.

# Conexión a MySQL (en tu compu: el MySQL que ves en Workbench)
DB_HOST=localhost
DB_PORT=3307
DB_USER=root
DB_PASSWORD=
DB_NAME=syncra
# Poné true si tu MySQL en la nube exige conexión segura (SSL)
DB_SSL=false

# Clave secreta para las sesiones. Una frase larga y al azar (32 caracteres o más).
JWT_SECRET=

# Puerto de la API en tu compu
API_PORT=3001

# Fotos y videos que se suben desde el panel (cuenta gratis en cloudinary.com).
# Están en el Dashboard de Cloudinary → "API Keys". En Netlify van en
# Site configuration → Environment variables, con los mismos nombres.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
